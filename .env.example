# Database Configuration
DATABASE_URL=postgresql://loom_user:loom_password@localhost:5432/loom_db
POSTGRES_USER=loom_user
POSTGRES_PASSWORD=loom_password
POSTGRES_DB=loom_db

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=loom_network

# Traefik Configuration
TRAEFIK_DOMAIN=localhost
TRAEFIK_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_PORT=8080

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_DEBUG=true

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/loom.log

# Container Defaults
DEFAULT_NETWORK=loom_network
DEFAULT_RESTART_POLICY=unless-stopped
